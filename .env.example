###############################################################################
# Top-level docker-compose envs (read by `docker compose up`).
# Copy to `.env` for local development. Production envs go in the Coolify panel.
###############################################################################

# PostgreSQL
POSTGRES_DB=skillflow
POSTGRES_USER=skillflow
POSTGRES_PASSWORD=skillflow

# Frontend bundle build-time URL — baked into the image, override per env.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCKS=false

# Flutter Web (mobile_web service) build-time vars — baked by `flutter build
# web` via `--dart-define`. Same caveat as NEXT_PUBLIC_*: a value change
# requires rebuilding the image (no runtime effect).
MOBILE_WEB_API_BASE_URL=https://api.skillflow.peladeiro.cloud
MOBILE_WEB_USE_MOCKS=false
