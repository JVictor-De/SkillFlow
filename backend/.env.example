###############################################################################
# Django
###############################################################################
DJANGO_SECRET_KEY=replace-me-in-prod
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,api,api.skillflow.local

###############################################################################
# Database
# Set USE_SQLITE=true for fast local dev / tests without Postgres.
###############################################################################
USE_SQLITE=false
POSTGRES_DB=skillflow
POSTGRES_USER=skillflow
POSTGRES_PASSWORD=skillflow
POSTGRES_HOST=db
POSTGRES_PORT=5432

###############################################################################
# CORS / CSRF (frontend Next.js + Flutter Web)
#
# In production set CORS_ALLOW_ALL_ORIGINS=false and list every public origin
# that hits the API (Next.js + Flutter Web). The Flutter Web bundle is served
# from `mobile.<domain>` and uses the SAME backend, so its origin MUST appear
# in CORS_ALLOWED_ORIGINS or browser preflights will fail (login/refresh/etc).
###############################################################################
CORS_ALLOW_ALL_ORIGINS=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8082
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8082
# Production example (override in Coolify, never commit real domains here):
#   CORS_ALLOW_ALL_ORIGINS=false
#   CORS_ALLOWED_ORIGINS=https://app.skillflow.peladeiro.cloud,https://mobile.skillflow.peladeiro.cloud
#   CSRF_TRUSTED_ORIGINS=https://app.skillflow.peladeiro.cloud,https://mobile.skillflow.peladeiro.cloud,https://api.skillflow.peladeiro.cloud

###############################################################################
# JWT
###############################################################################
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=7

###############################################################################
# Celery / Redis
###############################################################################
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false

###############################################################################
# LLM service
# `mock` is fully deterministic and never hits the network.
# Switching to `openai` requires LLM_API_KEY and LLM_MODEL.
###############################################################################
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=mock-model-1

###############################################################################
# Production-only flags (override via Coolify panel, never commit a real value)
###############################################################################
# SECURE_SSL_REDIRECT=true
# LOG_LEVEL=INFO
