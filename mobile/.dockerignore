# ----------------------------------------------------------------------------
# .dockerignore for Flutter Web build (mobile/Dockerfile.web).
# Goal: keep the build context small and reproducible. Anything regenerated by
# `flutter pub get` / `flutter build web` inside the container should NOT be
# shipped from the host.
# ----------------------------------------------------------------------------

# Flutter / Dart caches
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub/
.pub-cache/

# Build outputs (regenerated inside the container)
build/

# Native platform folders are irrelevant to a `flutter build web` run and only
# bloat the context. The Dockerfile uses `flutter create --platforms=web` to
# scaffold the `web/` folder when missing.
android/
ios/
linux/
macos/
windows/

# IDE / OS
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Tests are not needed to produce the production web bundle.
test/
integration_test/

# Local env files / secrets — never bake into the image.
.env
.env.*
!.env.example

# Git / CI metadata
.git/
.gitignore
.github/

# Coverage / logs
coverage/
*.log
